{
  "info": {
    "_postman_id": "b72a1ef5-cb76-42df-92f9-ad294759be87",
    "name": "Stage 9 Background Job Scheduler",
    "description": "Runnable checks for the background job scheduler API. Import this collection with either the local or live environment, select that environment, then run Dashboard, Jobs, Workflows, and DLQ in order. Live Events contains a long-lived SSE stream and is intended for manual use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://hng14-stage9-vm.duckdns.org"
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "workflowJobId",
      "value": ""
    },
    {
      "key": "scheduledAt",
      "value": ""
    },
    {
      "key": "dlqJobAvailable",
      "value": "false"
    }
  ],
  "item": [
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status ok', () => pm.expect(pm.response.code).to.eql(200));",
                  "const body = pm.response.json();",
                  "pm.test('dashboard has active_workers', () => pm.expect(body).to.have.property('active_workers'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "description": "Returns scheduler totals and the current active worker count.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboard"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create job",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('scheduledAt', new Date(Date.now() + 5 * 60 * 1000).toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status created', () => pm.expect(pm.response.code).to.eql(201));",
                  "const body = pm.response.json();",
                  "pm.test('created job has an id', () => pm.expect(body.id).to.be.a('string').and.not.empty);",
                  "pm.test('created job is pending', () => pm.expect(body.status).to.eql('pending'));",
                  "pm.collectionVariables.set('jobId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "description": "Creates a report job scheduled five minutes ahead and saves its ID.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"generate_report\",\n  \"priority\": 2,\n  \"payload\": {\n    \"requested_by\": \"postman\"\n  },\n  \"scheduled_at\": \"{{scheduledAt}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status ok', () => pm.expect(pm.response.code).to.eql(200));",
                  "const body = pm.response.json();",
                  "pm.test('requested job is returned', () => pm.expect(body.id).to.eql(pm.collectionVariables.get('jobId')));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "description": "Gets the job created earlier in the Jobs folder.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List jobs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status ok', () => pm.expect(pm.response.code).to.eql(200));",
                  "const body = pm.response.json();",
                  "pm.test('job list has items', () => pm.expect(body.items).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "description": "Lists jobs and verifies the paginated items shape.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cancel job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status ok', () => pm.expect(pm.response.code).to.eql(200));",
                  "const body = pm.response.json();",
                  "pm.test('job is cancelled', () => pm.expect(body.status).to.eql('cancelled'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "description": "Cancels the pending job created at the start of the folder.",
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{jobId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{jobId}}",
                "cancel"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Workflows",
      "item": [
        {
          "name": "Create generic workflow",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status created', () => pm.expect(pm.response.code).to.eql(201));",
                  "const body = pm.response.json();",
                  "pm.test('workflow returns jobs', () => pm.expect(body.jobs).to.be.an('array').and.not.empty);",
                  "pm.collectionVariables.set('workflowJobId', body.jobs[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "description": "Creates a three-step dependency workflow and saves its first job ID.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobs\": [\n    {\n      \"client_id\": \"report\",\n      \"type\": \"generate_report\",\n      \"priority\": 2,\n      \"payload\": {\n        \"requested_by\": \"postman\"\n      }\n    },\n    {\n      \"client_id\": \"upload\",\n      \"type\": \"upload_file\",\n      \"depends_on\": [\n        \"report\"\n      ]\n    },\n    {\n      \"client_id\": \"email\",\n      \"type\": \"send_email\",\n      \"payload\": {\n        \"to\": \"demo@example.com\"\n      },\n      \"depends_on\": [\n        \"upload\"\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workflows",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "workflows"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get workflow job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status ok', () => pm.expect(pm.response.code).to.eql(200));",
                  "const body = pm.response.json();",
                  "pm.test('workflow job is returned', () => pm.expect(body.id).to.eql(pm.collectionVariables.get('workflowJobId')));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "description": "Gets the first job returned by the generic workflow request.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs/{{workflowJobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{workflowJobId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create report email demo workflow",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status created', () => pm.expect(pm.response.code).to.eql(201));",
                  "const body = pm.response.json();",
                  "pm.test('demo workflow returns jobs', () => pm.expect(body.jobs).to.be.an('array').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "description": "Creates the built-in report, upload, and email demonstration workflow.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workflows/report-email-demo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "workflows",
                "report-email-demo"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "DLQ",
      "item": [
        {
          "name": "List dead letter queue",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status ok', () => pm.expect(pm.response.code).to.eql(200));",
                  "const body = pm.response.json();",
                  "pm.test('dead letter list has items', () => pm.expect(body.items).to.be.an('array'));",
                  "const first = body.items[0];",
                  "pm.collectionVariables.set('dlqJobAvailable', first ? 'true' : 'false');",
                  "if (first) pm.collectionVariables.set('jobId', first.job_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "description": "Lists dead letter entries and selects the first job for the retry request.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dlq",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dlq"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Retry dead letter job",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('dlqJobAvailable') !== 'true') pm.execution.skipRequest();"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status ok', () => pm.expect(pm.response.code).to.eql(200));",
                  "const body = pm.response.json();",
                  "pm.test('dead letter job is pending', () => pm.expect(body.status).to.eql('pending'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "description": "Retries {{jobId}} only when it is actually in the DLQ; run the list request first.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dlq/{{jobId}}/retry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dlq",
                "{{jobId}}",
                "retry"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Live Events",
      "item": [
        {
          "name": "Job event stream",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status ok', () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test('response is an event stream', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "description": "Long-lived SSE stream for manual use; exclude this request from Collection Runner runs.",
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events/jobs?after_id=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "jobs"
              ],
              "query": [
                {
                  "key": "after_id",
                  "value": "0"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
