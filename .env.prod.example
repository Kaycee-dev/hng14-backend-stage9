# Copy to `.env` on the VPS and fill in real values. NEVER commit the real .env.
# The password in POSTGRES_PASSWORD and the one inside DATABASE_URL must match.

POSTGRES_USER=scheduler
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
POSTGRES_DB=scheduler

DATABASE_URL=postgresql://scheduler:change-me-to-a-long-random-secret@postgres:5432/scheduler

NODE_ENV=production
TZ=UTC
DLQ_ALERT_EMAIL=you@example.com

# For your reference / Nginx config — not read by the app:
PUBLIC_DOMAIN=YOUR_SUBDOMAIN.duckdns.org
